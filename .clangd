CompileFlags:
  CompilationDatabase: build/Debug
  Add:
    - "--target=arm-none-eabi"
  Remove:
    - "-mms-bitfields"
    - "-fms-extensions"
    - "-fms-compatibility"
    - "-mthumb-interwork"
    - "-fno-threadsafe-statics"

Index:
  Background: Build

---
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
